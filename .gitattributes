# Normalize text files and keep the Windows working tree consistently CRLF.
* text=auto

*.php  text eol=crlf
*.css  text eol=crlf
*.js   text eol=crlf
*.txt  text eol=crlf
*.md   text eol=crlf
*.json text eol=crlf
*.xml  text eol=crlf
*.yml  text eol=crlf
*.yaml text eol=crlf
*.ps1  text eol=crlf
*.bat  text eol=crlf
*.po   text eol=crlf
*.pot  text eol=crlf

# Binary files must never undergo line-ending conversion.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.mo   binary
*.zip  binary